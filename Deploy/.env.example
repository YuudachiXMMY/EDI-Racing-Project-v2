# EDI-Racing Docker Configuration
# Copy to .env and adjust as needed

# Host ports (fallback when Traefik is not running)
GAME_PORT=3900
API_PORT=3901

# Traefik domain routing
GAME_DOMAIN=edi-racing.localhost
API_DOMAIN=api.edi-racing.localhost

# Host-token secret shared by web-app + Server. MUST be a strong random value when
# REQUIRE_HOST_TOKEN=true — both containers refuse to boot with the committed default.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=change-me-to-a-random-secret
REQUIRE_HOST_TOKEN=false
